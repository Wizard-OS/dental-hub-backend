NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_SWAGGER=true
JWT_SECRET=change_this_secret

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=DentalHubDB
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SYNCHRONIZE=true

# Personal Google Drive storage (Google does not create DentalHub app sessions)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Persistent 32-byte key, encoded as 64 hex characters.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_SYNC_WORKER_ENABLED=true

# Password recovery email, required before Google-only accounts move to passwords.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

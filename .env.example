# App
NODE_ENV=development
PORT=3000
HOST_API=http://localhost:3000/api
JWT_SECRET=change_this_secret
INTEGRATION_TOKEN_ENCRYPTION_KEY=change_this_storage_integration_secret
ENABLE_SEED_ENDPOINT=false

# Country metadata - Rest Countries v5
# REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5
# REST_COUNTRIES_API_KEY=

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=DentalHubDB
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false

# TypeORM
DB_SYNCHRONIZE=true

# Billing - PayPal Subscriptions
# PAYPAL_ENV=sandbox # sandbox | live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BRAND_NAME=Dental Hub
# PAYPAL_RETURN_URL=http://localhost:3000/billing/success
# PAYPAL_CANCEL_URL=http://localhost:3000/billing/cancel
# PAYPAL_PREMIUM_MONTHLY_PLAN_ID=
# PAYPAL_PREMIUM_YEARLY_PLAN_ID=
# LICENSE_HASH_SECRET=change_this_license_hash_secret

# Membership UI offers. Separate from the legacy plans above.
# Each plan must include 14 free days, zero setup fee and no additional tax.
# PAYPAL_PREMIUM_MONTHLY_TRIAL_PLAN_ID=
# PAYPAL_PREMIUM_YEARLY_TRIAL_PLAN_ID=
# 14 days free, then one discounted YEAR at USD90, then recurring YEAR at USD100.
# PAYPAL_PREMIUM_YEARLY_WELCOME_TRIAL_PLAN_ID=

# Saved methods and merchant-managed recurring billing use the PayPal credentials
# and return URLs above; they do not require pre-created PayPal plan IDs.
# Enable Vault + Advanced Card Payments in the merchant's PayPal account.
# PayPal webhooks: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.PENDING, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED.

# Trial reminders (Resend; a verified sender domain is required)
# RESEND_API_KEY=
# MEMBERSHIP_EMAIL_FROM=DentalHub <billing@your-domain.com>
# BILLING_WORKER_ENABLED=true
